{
  "name": "foldrun",
  "version": "0.2.0",
  "description": "Agents are folders. Write them, check them, run them — on your machine.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "foldrun": "bin/foldrun.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@foldrun/core": "^0.1.0"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "e2e": "FOLDRUN_E2E=1 FOLDRUN_DATA=$(mktemp -d /tmp/foldrun-e2e-XXXXXX) node --test --test-timeout=300000 tests/e2e.test.ts",
    "test": "FOLDRUN_DATA=$(mktemp -d /tmp/foldrun-test-XXXXXX) node --test tests/cli-secrets.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foldrun-io/foldrun-cli.git"
  },
  "homepage": "https://foldrun.io",
  "bugs": {
    "url": "https://github.com/foldrun-io/foldrun-cli/issues"
  },
  "keywords": [
    "agents",
    "llm",
    "markdown",
    "workflows",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  }
}
